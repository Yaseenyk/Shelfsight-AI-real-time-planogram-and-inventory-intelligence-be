# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment
.env
.env.local

# Database
*.db
*.db-wal
*.db-shm
*.sqlite3

# Model weights & datasets (never commit binaries)
models/weights/*
!models/weights/.gitkeep
models/datasets/**/images/
models/datasets/**/labels/
runs/

# Runtime data
data/uploads/
data/samples/
data/crops/

# Benchmark frames — datasets stay out of the repo (keep the READMEs)
data/test_images/**
!data/test_images/README.md
data/test_freshness/**
!data/test_freshness/README.md
data/test_expiry/**
!data/test_expiry/README.md
data/freshness/

# Evaluation output
evaluation/reports/*
!evaluation/reports/.gitkeep

# Published figures are build artefacts of one benchmark run — regenerate with
# `make evaluate` rather than citing whatever was committed months ago.
docs/publication_metrics/*
# ...but prose in this directory is source material for the paper, not output.
!docs/publication_metrics/*.md

# Curated/raw datasets
data/raw/
data/detection/

# Exported model artefacts
*.onnx
*.torchscript.pt

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Cluster-repartitioned corpora: regenerate with `make cluster-split`
data/freshness_clean/
# SKU-110K subset lists hold absolute paths to a local dataset cache, so they
# are machine-specific; the manifest recording how they were built is tracked.
models/datasets/sku110k_subset/*.txt
