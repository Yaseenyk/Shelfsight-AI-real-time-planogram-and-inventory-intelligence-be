# Copy to `.env`. Commit the .env used for a published experiment run so the
# thresholds behind every reported number are traceable.

# --- application ---
APP_NAME=ShelfSight AI
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- database ---
DATABASE_URL=sqlite:///./shelfsight.db
SQL_ECHO=false

# --- detection (YOLOv8) ---
# Fine-tuned on SKU-110K. yolov8n.pt is the untrained COCO baseline and will
# detect people and cars rather than shelf products - do not point here.
DETECTION_WEIGHTS=models/weights/shelfsight-sku110k.pt
DETECTION_CONF_THRESHOLD=0.35
DETECTION_IOU_NMS=0.45
DETECTION_IMG_SIZE=640
DETECTION_DEVICE=cpu

# --- planogram compliance ---
COMPLIANCE_IOU_THRESHOLD=0.50
COMPLIANCE_CENTER_DISTANCE_THRESHOLD=0.08
COMPLIANCE_ROW_BAND_TOLERANCE=0.05

# --- freshness classifier ---
# Trained on the leak-free cluster split. The checkpoint carries its own
# input_size and class order, which override the values below.
FRESHNESS_WEIGHTS=models/weights/freshness_mobilenetv2_clean.pt
FRESHNESS_BACKBONE=mobilenet_v2
FRESHNESS_INPUT_SIZE=224
FRESHNESS_CLASSES=fresh,ripening,spoiled

# --- expiry OCR ---
OCR_LANGUAGES=en
OCR_GPU=false
OCR_MIN_CONFIDENCE=0.30
EXPIRY_NEAR_THRESHOLD_DAYS=7
EXPIRY_DAYFIRST=true

# --- local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_S=120
OLLAMA_TEMPERATURE=0.2
